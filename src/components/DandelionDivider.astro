---
// Section divider: a hairline rule with Malithi's dandelions resting on top of it.
---
<div class="py-7" aria-hidden="true">
  <div class="flex items-end justify-center gap-8 overflow-hidden sm:gap-12">
    {Array.from({ length: 9 }).map(() => (
      <img src="/dandelion.svg" alt="" class="size-6 flex-none translate-y-[3px]" />
    ))}
  </div>
  <div class="h-px w-full bg-line"></div>
</div>
