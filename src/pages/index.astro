---
import "../styles/global.css";

const swatches = [
  { name: "paper", cls: "bg-paper border border-line" },
  { name: "paper-2", cls: "bg-paper-2" },
  { name: "cream", cls: "bg-cream border border-line" },
  { name: "line", cls: "bg-line" },
  { name: "ink", cls: "bg-ink" },
  { name: "muted", cls: "bg-muted" },
  { name: "forest", cls: "bg-forest" },
  { name: "forest-deep", cls: "bg-forest-deep" },
  { name: "chart", cls: "bg-chart" },
  { name: "amber", cls: "bg-amber" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Foraging Texas · foundation check</title>
  </head>
  <body class="min-h-dvh">
    <main class="mx-auto max-w-3xl px-6 py-16">
      <p class="text-xs font-bold uppercase tracking-widest text-muted">Phase 1 · foundation</p>
      <h1 class="font-display text-5xl mt-2 mb-4">Know what your ancestors knew.</h1>
      <p class="max-w-[60ch] text-muted mb-10">
        If this headline renders in Young Serif on cream paper, the tokens are wired.
        This page gets replaced by the real Today page in Phase 5.
      </p>

      <div class="grid grid-cols-5 gap-3 mb-10">
        {swatches.map((s) => (
          <div>
            <div class={`h-14 rounded-xl ${s.cls}`}></div>
            <p class="text-xs text-muted mt-1">{s.name}</p>
          </div>
        ))}
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <button class="rounded-full bg-chart px-7 py-3.5 font-bold text-chart-ink">Chartreuse pill</button>
        <button class="rounded-full bg-forest px-7 py-3.5 font-bold text-cream">Forest pill</button>
        <div class="rounded-2xl bg-amber px-6 py-3.5 font-medium text-amber-ink">Amber block</div>
      </div>

      <div class="mt-10 w-44 overflow-hidden bg-forest text-cream rounded-t-[200px] rounded-b-[20px] aspect-[4/4.6] grid place-items-end p-4">
        <span class="text-sm">arched frame</span>
      </div>
    </main>
  </body>
</html>
