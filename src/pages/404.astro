---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Lost the trail · Merriwether's Foraging Texas">
  <main class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-xl py-24 text-center">
      <p class="text-xs font-bold uppercase tracking-widest text-muted">404</p>
      <h1 class="mt-3 font-display text-5xl tracking-tight text-ink">Lost the trail.</h1>
      <p class="mx-auto mt-4 max-w-[44ch] text-muted">
        This page isn't growing here. The plant you're after may have moved,
        or the link may have wilted.
      </p>
      <a href="/plants" class="mt-8 inline-block rounded-full bg-chart px-7 py-3.5 font-bold text-chart-ink no-underline">Browse every plant</a>
    </div>
  </main>
</Layout>
