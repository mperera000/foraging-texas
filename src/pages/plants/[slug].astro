---
import { getCollection, type CollectionEntry } from "astro:content";
import { Image, getImage } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import PlantCard from "../../components/PlantCard.astro";

export async function getStaticPaths() {
  const plants = await getCollection("plants");
  return plants.map((plant) => ({ params: { slug: plant.id }, props: { plant } }));
}

interface Props {
  plant: CollectionEntry<"plants">;
}
const { plant } = Astro.props;
const d = plant.data;

const all = await getCollection("plants");
const similar = d.similar
  .map((slug) => all.find((p) => p.id === slug))
  .filter((p): p is CollectionEntry<"plants"> => Boolean(p));

const facts = [
  { key: "What", value: d.facts.what },
  { key: "How", value: d.facts.how },
  { key: "When", value: d.facts.when },
  { key: "Where", value: d.facts.where },
  { key: "Value", value: d.facts.value },
];
const photo = d.photos[0];
const og = await getImage({ src: photo.src, width: 1200 });
---

<Layout title={`${d.name} · Merriwether's Foraging Texas`} description={d.facts.what} ogImage={og.src}>
  <main class="mx-auto max-w-6xl px-6">
    <p class="pt-8 text-sm text-muted">
      <a href="/plants" class="font-bold text-forest underline underline-offset-[3px]">All plants</a>
      <span class="mx-1">/</span>{d.type}
      <span class="mx-1">/</span>{d.name}
    </p>

    <div class="mt-6 grid items-start gap-10 lg:grid-cols-[6fr_5fr] lg:gap-14">
      <div class="overflow-hidden rounded-t-[260px] rounded-b-[26px] max-lg:max-h-[420px] lg:sticky lg:top-24">
        <Image src={photo.src} alt={photo.alt} width={900} class="size-full object-cover" loading="eager" />
      </div>

      <div>
        <h1 class="font-display text-5xl tracking-tight text-ink max-sm:text-4xl">{d.name}</h1>
        <p class="mt-2 text-lg italic text-muted">
          {d.latin}, {d.family.toLowerCase()} family. {d.abundance[0].toUpperCase() + d.abundance.slice(1)} in
          {" "}{d.regions.join(" and ")} Texas.
        </p>

        <div class="mt-7 overflow-hidden rounded-3xl bg-forest text-cream">
          <p class="px-6 pt-4 pb-1 font-display text-lg">At a glance</p>
          <dl>
            {facts.map((f) => (
              <div class="grid grid-cols-[86px_1fr] gap-3 border-t border-cream/10 px-6 py-3 text-[14.5px] first-of-type:border-t-0">
                <dt class="pt-0.5 text-[11.5px] font-bold uppercase tracking-wider text-chart/80">{f.key}</dt>
                <dd>{f.value}</dd>
              </div>
            ))}
          </dl>
        </div>

        <p class="mt-4 rounded-2xl bg-amber px-5 py-4 text-[14.5px] font-medium text-amber-ink">
          <strong class="font-bold">Caution:</strong> {d.caution}
        </p>

        <div class="mt-2 max-w-[60ch]">
          {d.sections.map((s) => (
            <section>
              <h2 class="mt-8 mb-2 font-display text-2xl text-ink">{s.title}</h2>
              <p class="leading-relaxed">{s.body}</p>
            </section>
          ))}
        </div>

        <p class="mt-8 text-[13px] text-muted">
          Photo: {photo.credit}, {photo.license}, via {photo.source}.
        </p>
      </div>
    </div>

    {similar.length > 0 && (
      <section class="mt-16">
        <h2 class="mb-5 font-display text-2xl text-ink">Forages well with</h2>
        <div class="grid grid-cols-2 gap-6 sm:max-w-md">
          {similar.map((p) => (
            <PlantCard plant={p} />
          ))}
        </div>
      </section>
    )}

    <p class="mt-14 rounded-2xl bg-paper-2 px-5 py-4 text-sm text-ink">
      <strong>Forage safely.</strong> Never eat a wild plant on this site's word alone. Confirm
      identity with several sources, learn the look-alikes, and when in doubt, leave it in the ground.
    </p>
  </main>
</Layout>
